# ============================================
# WeChatGPT-Dual v3.0 Configuration
# ============================================

# --- Telegram ---
BOT_TOKEN=your_telegram_bot_token

# --- AI Engine: OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TIMEOUT=60

# --- AI Engine: Claude ---
CLAUDE_API_KEY=sk-ant-your-claude-key
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-3-haiku-20240307
CLAUDE_MAX_TOKENS=2000
CLAUDE_TEMPERATURE=0.7
CLAUDE_TIMEOUT=60

# --- Engine Config ---
PRIMARY_ENGINE=openai
FAILOVER_ENABLED=true
FAILOVER_MAX_RETRIES=2
FAILOVER_TIMEOUT=30.0
RATE_LIMIT_COOLDOWN=60

# --- System ---
SYSTEM_PROMPT=你是一个有用的AI助手。回答简洁、准确、有帮助。

# --- Context ---
MAX_HISTORY=20
SUMMARY_THRESHOLD=16
SUMMARY_KEEP_RECENT=4

# --- Knowledge Base ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
KNOWLEDGE_STORE_DIR=knowledge_store

# --- Database ---
DB_PATH=data/wechatgpt.db

# --- Webhook API ---
WEBHOOK_TOKEN=your_secret_token
